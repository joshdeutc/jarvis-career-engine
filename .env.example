# Configuration des Clés API (100% Gratuites)

# 1. Groq Cloud (Indispensable pour l'analyse LLM LLaMA 3.3 70B gratuite)
# Obtenez votre clé gratuite en 1 clic sur https://console.groq.com
GROQ_API_KEY=gsk_votre_cle_groq_ici

# 2. Telegram Bot (Pour recevoir vos alertes sur votre téléphone ou PC)
# Créez votre bot avec @BotFather sur Telegram pour obtenir le TOKEN
# Obtenez votre CHAT_ID en envoyant un message à @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# 3. France Travail (Optionnel - Pour interroger les entreprises protégées comme BNP Paribas)
# Créez gratuitement un compte sur https://francetravail.io/ -> Espace Partenaire
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
